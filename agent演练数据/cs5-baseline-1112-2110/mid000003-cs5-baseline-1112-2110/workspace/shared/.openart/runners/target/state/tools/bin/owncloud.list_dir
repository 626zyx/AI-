#!/usr/bin/env bash
set -euo pipefail
if [ -n "${OWNCLOUD_URL+x}" ]; then export OWNCLOUD_URL="${OWNCLOUD_URL}"; fi
if [ -n "${OWNCLOUD_USERNAME+x}" ]; then export OWNCLOUD_USERNAME="${OWNCLOUD_USERNAME}"; fi
if [ -n "${OWNCLOUD_PASSWORD+x}" ]; then export OWNCLOUD_PASSWORD="${OWNCLOUD_PASSWORD}"; fi
exec /opt/openart-venv/bin/python3 /workspace/.openart/runners/target/state/tools/src/owncloud.list_dir/scripts/owncloud_list_dir.py "$@"
